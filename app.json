{
  "expo": {
    "name": "finny",
    "slug": "finny",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/branding/finny-logo.png",
    "scheme": "finny",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/branding/finny-logo.png",
      "bundleIdentifier": "finny.lct",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/branding/finny-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "finny.lct"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./src/assets/branding/finny-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b37bb3f-9035-445d-b425-02101fd0b730"
      }
    }
  }
}
