{
  "expo": {
    "name": "finny",
    "slug": "finny",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo/finni-logo.png",
    "scheme": "finny",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/logo/finni-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/logo/finni-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./src/assets/logo/finni-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
